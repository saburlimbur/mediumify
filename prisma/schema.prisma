// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @default(uuid()) @db.Char(36)
  name     String
  email    String    @unique
  password String
  photo    String
  bio      String
  Post     Post[]
  Library  Library[]

  @@map("users")
}

model Post {
  id          String @id @default(uuid()) @db.Char(36)
  title       String
  description String
  photo       String

  topics TopicsType

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  libraries Library[] @relation("LibrarySavedPosts")

  @@map("posts")
}

model Library {
  id String @id @default(uuid()) @db.Char(36)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  posts Post[] @relation("LibrarySavedPosts")

  @@map("librarys")
}

enum TopicsType {
  Life
  SelfImprovement
  Technology
  SoftwareDevelopment
  Society
  Culture
  World
  Poetry
}
