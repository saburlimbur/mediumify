// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid()) @db.Char(36)
  name     String
  email    String @unique
  password String
  photo    String
  bio      String @default("")

  Post            Post[]
  Library         Library[]
  password_resets PasswordReset[]

  @@map("users")
}

model Post {
  id          String @id @default(uuid()) @db.Char(36)
  title       String
  description String
  photo       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics TopicsType

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  libraries Library[] @relation("LibrarySavedPosts")

  @@map("posts")
}

model Library {
  id String @id @default(uuid()) @db.Char(36)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  posts Post[] @relation("LibrarySavedPosts")

  @@map("libraries")
}

model PasswordReset {
  id      String @id @default(uuid()) @db.Char(36)
  user_id String
  token   String
  user    User   @relation(fields: [user_id], references: [id])

  @@map("user_password_resets")
}

enum TopicsType {
  Life
  SelfImprovement
  Technology
  SoftwareDevelopment
  Society
  Culture
  World
  Poetry
}
